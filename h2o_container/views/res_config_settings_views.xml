<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_h2o_container" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.h2o_container</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="h2o_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='h2o_base']" position="inside">
                <block title="Bottles and deposits" id="h2o_settings_container">
                    <setting string="Deposit account" help="Liability account for bottle deposits charged on invoices.">
                        <field name="h2o_deposit_account_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
