<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_quant_view_list_h2o_vehicle" model="ir.ui.view">
        <field name="name">stock.quant.list.h2o_vehicle</field>
        <field name="model">stock.quant</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Vehicle Stock" create="false" edit="false" delete="false"
                  decoration-danger="quantity &lt; 0">
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total"/>
                <field name="uom_id" groups="uom.group_uom"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="stock_quant_view_search_h2o_vehicle" model="ir.ui.view">
        <field name="name">stock.quant.search.h2o_vehicle</field>
        <field name="model">stock.quant</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="location_id"/>
                <field name="product_id"/>
                <filter string="Negative" name="negative" domain="[('quantity', '&lt;', 0)]"/>
                <group>
                    <filter string="Vehicle" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="h2o_vehicle_stock_action" model="ir.actions.act_window">
        <field name="name">Vehicle Stock</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="stock_quant_view_list_h2o_vehicle"/>
        <field name="search_view_id" ref="stock_quant_view_search_h2o_vehicle"/>
        <field name="domain">[('location_id.h2o_vehicle_id', '!=', False), ('quantity', '!=', 0)]</field>
        <field name="context">{'search_default_group_location': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">The vehicles are empty</p>
            <p>Trips load the vehicles when they leave and unload them when they close.</p>
        </field>
    </record>
</odoo>
