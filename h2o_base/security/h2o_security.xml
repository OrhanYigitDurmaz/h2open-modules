<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_h2open" model="ir.module.category">
        <field name="name">H2Open</field>
        <field name="sequence">5</field>
    </record>

    <record id="res_groups_privilege_h2open" model="res.groups.privilege">
        <field name="name">Water Delivery</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_h2open"/>
    </record>

    <record id="group_h2o_driver" model="res.groups">
        <field name="name">Driver</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_h2open"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Uses the driver app: sees own trips and stops, delivers, collects empties and payments.</field>
    </record>

    <record id="group_h2o_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_h2open"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Invoices, deposits, monthly statements and driver cash handovers.</field>
    </record>

    <record id="group_h2o_dispatcher" model="res.groups">
        <field name="name">Dispatcher</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_h2open"/>
        <field name="implied_ids" eval="[(4, ref('group_h2o_driver'))]"/>
        <field name="comment">Takes orders, manages customers, plans routes and trips.</field>
    </record>

    <record id="group_h2o_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_h2open"/>
        <field name="implied_ids" eval="[(4, ref('group_h2o_dispatcher')), (4, ref('group_h2o_accountant'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to H2Open, including configuration.</field>
    </record>
</odoo>
