<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="h2o_route_view_list" model="ir.ui.view">
        <field name="name">h2o.route.list</field>
        <field name="model">h2o.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="zone_ids" widget="many2many_tags"/>
                <field name="weekday_ids" widget="many2many_tags"/>
                <field name="vehicle_id"/>
                <field name="driver_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="h2o_route_view_form" model="ir.ui.view">
        <field name="name">h2o.route.form</field>
        <field name="model">h2o.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_trips" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="trip_count" widget="statinfo" string="Trips"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Kadıköy - Üsküdar"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="weekday_ids" widget="many2many_tags" placeholder="Every day"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="driver_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Zones" name="zones">
                            <field name="zone_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="weekday_ids" widget="many2many_tags"/>
                                    <field name="partner_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes about this route..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="h2o_route_view_search" model="ir.ui.view">
        <field name="name">h2o.route.search</field>
        <field name="model">h2o.route</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="zone_ids"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="h2o_route_action" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">h2o.route</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a delivery route</p>
            <p>A route groups delivery zones served by one vehicle and driver on its running days.</p>
        </field>
    </record>
</odoo>
