<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="h2o_container_balance_view_list" model="ir.ui.view">
        <field name="name">h2o.container.balance.list</field>
        <field name="model">h2o.container.balance</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="partner_id"/>
                <field name="customer_type" optional="show"/>
                <field name="zone_id" optional="show"/>
                <field name="product_id"/>
                <field name="qty_out" sum="Total" optional="hide"/>
                <field name="qty_in" sum="Total" optional="hide"/>
                <field name="qty" sum="Total" decoration-danger="qty &lt; 0"/>
                <field name="deposit_amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="last_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="h2o_container_balance_view_pivot" model="ir.ui.view">
        <field name="name">h2o.container.balance.pivot</field>
        <field name="model">h2o.container.balance</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="zone_id" type="row"/>
                <field name="product_id" type="col"/>
                <field name="qty" type="measure"/>
                <field name="deposit_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="h2o_container_balance_view_search" model="ir.ui.view">
        <field name="name">h2o.container.balance.search</field>
        <field name="model">h2o.container.balance</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="zone_id"/>
                <filter string="Holding Bottles" name="holding" domain="[('qty', '!=', 0)]"/>
                <filter string="Deposit Held" name="deposit_held" domain="[('deposit_amount', '!=', 0)]"/>
                <group>
                    <filter string="Delivery Zone" name="group_zone" context="{'group_by': 'zone_id'}"/>
                    <filter string="Customer Type" name="group_customer_type" context="{'group_by': 'customer_type'}"/>
                    <filter string="Container" name="group_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="h2o_container_balance_action" model="ir.actions.act_window">
        <field name="name">Bottle Balances</field>
        <field name="res_model">h2o.container.balance</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_holding': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No customer holds bottles</p>
            <p>Bottles and deposits each customer holds, computed from the bottle ledger.</p>
        </field>
    </record>
</odoo>
