<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="h2o_zone_view_form_dispatch" model="ir.ui.view">
        <field name="name">h2o.zone.form.h2o_dispatch</field>
        <field name="model">h2o.zone</field>
        <field name="inherit_id" ref="h2o_customer.h2o_zone_view_form"/>
        <field name="arch" type="xml">
            <field name="weekday_ids" position="after">
                <field name="h2o_route_id"/>
            </field>
        </field>
    </record>

    <record id="h2o_zone_view_list_dispatch" model="ir.ui.view">
        <field name="name">h2o.zone.list.h2o_dispatch</field>
        <field name="model">h2o.zone</field>
        <field name="inherit_id" ref="h2o_customer.h2o_zone_view_list"/>
        <field name="arch" type="xml">
            <field name="weekday_ids" position="after">
                <field name="h2o_route_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
