<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bottles outstanding: graph on top of h2o_container's balance list and pivot. -->
    <record id="h2o_container_balance_view_graph" model="ir.ui.view">
        <field name="name">h2o.container.balance.graph</field>
        <field name="model">h2o.container.balance</field>
        <field name="arch" type="xml">
            <graph string="Bottles Outstanding" type="bar" sample="1">
                <field name="zone_id"/>
                <field name="customer_type"/>
                <field name="qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="h2o_report_bottles_action" model="ir.actions.act_window">
        <field name="name">Bottles Outstanding</field>
        <field name="res_model">h2o.container.balance</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="h2o_container_balance_view_graph"/>
        <field name="domain">[('qty', '!=', 0)]</field>
    </record>

    <!-- Cash handed in by drivers against what their stops collected. -->
    <record id="h2o_cash_handover_view_pivot" model="ir.ui.view">
        <field name="name">h2o.cash.handover.pivot</field>
        <field name="model">h2o.cash.handover</field>
        <field name="arch" type="xml">
            <pivot string="Cash Handovers" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="driver_id" type="col"/>
                <field name="expected" type="measure"/>
                <field name="counted" type="measure"/>
                <field name="difference" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="h2o_report_handover_action" model="ir.actions.act_window">
        <field name="name">Cash Handovers</field>
        <field name="res_model">h2o.cash.handover</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="view_id" ref="h2o_cash_handover_view_pivot"/>
    </record>
</odoo>
