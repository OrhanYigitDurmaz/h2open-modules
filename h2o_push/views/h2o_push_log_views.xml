<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="h2o_push_log_view_list" model="ir.ui.view">
        <field name="name">h2o.push.log.list</field>
        <field name="model">h2o.push.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="state == 'failed'">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="device_id"/>
                <field name="state"/>
                <field name="error"/>
            </list>
        </field>
    </record>

    <record id="h2o_push_log_view_form" model="ir.ui.view">
        <field name="name">h2o.push.log.form</field>
        <field name="model">h2o.push.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Date"/>
                            <field name="user_id"/>
                            <field name="device_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="error"/>
                        </group>
                    </group>
                    <group>
                        <field name="data"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="h2o_push_log_view_search" model="ir.ui.view">
        <field name="name">h2o.push.log.search</field>
        <field name="model">h2o.push.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="h2o_push_log_action" model="ir.actions.act_window">
        <field name="name">Push Log</field>
        <field name="res_model">h2o.push.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No push sent in the last 30 days</p>
        </field>
    </record>

    <menuitem id="menu_h2o_push_log" name="Push Log" parent="h2o_base.menu_h2o_config"
              sequence="71" action="h2o_push_log_action"/>
</odoo>
