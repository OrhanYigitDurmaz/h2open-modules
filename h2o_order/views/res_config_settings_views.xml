<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_h2o_order" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.h2o_order</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="h2o_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='h2o_base']" position="inside">
                <block title="Prices per customer type" id="h2o_settings_pricelists">
                    <setting string="Home customers" help="Pricelist given to home customers when their type is set.">
                        <field name="h2o_pricelist_home_id" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Office customers" help="Pricelist given to office customers when their type is set.">
                        <field name="h2o_pricelist_office_id" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Resellers" help="Pricelist given to resellers when their type is set.">
                        <field name="h2o_pricelist_reseller_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
