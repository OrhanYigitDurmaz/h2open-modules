<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_h2o_billing" model="ir.ui.view">
        <field name="name">account.move.form.inherit.h2o_billing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']/field[@name='invoice_user_id']" position="after">
                <field name="h2o_stop_id" invisible="not h2o_stop_id"/>
                <field name="h2o_statement_month" invisible="not h2o_statement_month"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_h2o_billing" model="ir.ui.view">
        <field name="name">account.move.search.inherit.h2o_billing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="h2o_stop_id"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Delivery Invoices" name="h2o_delivery" domain="[('h2o_stop_id', '!=', False)]"/>
                <filter string="Monthly Statements" name="h2o_statement" domain="[('h2o_statement_month', '!=', False)]"/>
                <group>
                    <filter string="Statement Month" name="group_h2o_statement_month"
                            context="{'group_by': 'h2o_statement_month:month'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="h2o_statement_action" model="ir.actions.act_window">
        <field name="name">Monthly Statements</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('h2o_statement_month', '!=', False)]</field>
        <field name="context">{'create': False, 'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No monthly statements yet</p>
            <p>Customers on account get one invoice per month for all their deliveries, created on the 1st
               for the previous month. Create them by hand with "Create Monthly Statements".</p>
        </field>
    </record>

    <record id="h2o_invoice_action" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund', 'out_receipt'))]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>
</odoo>
